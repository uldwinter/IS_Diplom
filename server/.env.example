PORT=8080
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_NAME=gifted_children

# Alternatively set DATABASE_URL to the PostgreSQL connection string.
# Public deployments require NODE_ENV=production and the exact HTTPS APP_ORIGIN.
# TRUST_PROXY=1
# ADMIN_LOGIN and ADMIN_EMAIL identify the first administrator during npm run bootstrap.
# Supply ADMIN_PASSWORD securely for bootstrap and remove it afterward.
